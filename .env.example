# ============================================================
# إعدادات بوت متجر شرائح الاتصال الإلكترونية (Telegram eSIM Store)
# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل:
#   cp .env.example .env
# ============================================================

# توكن البوت من @BotFather
BOT_TOKEN=123456789:ABCDEF_your_bot_token_here

# المعرف الرقمي لحساب مالك البوت في تيليجرام (من @userinfobot)
ADMIN_ID=123456789

# معرف حساب الدعم الفني بدون علامة @
SUPPORT_USERNAME=Support

# بيانات استقبال المدفوعات لشحن الرصيد
BINANCE_ID=Your_Binance_Pay_ID
INSTAPAY_ADDRESS=yourname@instapay

# عملة المتجر الافتراضية (مثل USD أو EGP)
CURRENCY=USD

# مسار ملف قاعدة البيانات (اختياري)
DB_PATH=./esim_store.db

# ============================================================
# الشحن التلقائي عبر Binance Pay (اختياري)
# اتركها فارغة إذا كنت تريد الشحن اليدوي فقط
# ============================================================

# نظام التشغيل: monitor (حساب عادي بمفتاح قراءة فقط) أو merchant (حساب تاجر)
BINANCE_PAY_MODE=

# ---- وضع monitor: مفتاح API عادي من حسابك الشخصي (قراءة فقط) ----
# العميل يحوّل إلى Binance ID الخاص بك ثم يرسل للبوت رقم العملية ليتحقق منه
# من حسابك في Binance: API Management ثم Create API
# فعّل صلاحية "Enable Reading" فقط، وقيّد المفتاح بعنوان IP الخاص بالسيرفر
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- وضع merchant: من لوحة تحكم التاجر Developers ثم API ----
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=

# الرابط العام الذي تصل عليه إشعارات الدفع (HTTPS) - وضع merchant فقط
# مثال: https://pay.yourdomain.com/binance/webhook
BINANCE_PAY_WEBHOOK_URL=

# المنفذ المحلي لخادم الإشعارات - وضع merchant فقط
BINANCE_PAY_LISTEN_HOST=127.0.0.1
BINANCE_PAY_LISTEN_PORT=8080

# عملة الدفع المقبولة في النظامين (USDT هو الافتراضي والأنسب)
BINANCE_PAY_CURRENCY=USDT

# مفتاح OCR.space (الطبقة المجانية) لقراءة صور إيصالات التحويل في وضع monitor
# احصل عليه مجاناً من https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=
